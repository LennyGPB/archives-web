ORA_API_URL=https://archives-api-production.up.railway.app
# Domaine public du site, utilisé pour les URL canoniques et les balises hreflang.
# Laisser vide en local ; renseigner en production (ex. https://mon-domaine.com).
NEXT_PUBLIC_SITE_URL=
# OAuth client ID (Web application) depuis https://console.cloud.google.com/apis/credentials
# Doit correspondre à GOOGLE_CLIENT_ID dans ora-api. Sans cette variable, le bouton
# "Se connecter avec Google" de la modale reste masqué.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
